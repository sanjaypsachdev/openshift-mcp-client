BASE_URL=https://your-vllm-host/v1
ASSISTANT_MODEL=llama-32-3b-instruct

# Native MCP client. MCP_TRANSPORT is sse (the default), streamable-http, or stdio.
# A direct SSE client can get HTTP 400 behind an OpenShift sticky-session route.
MCP_URL=https://your-openshift-mcp-host/sse

# MCP_TRANSPORT=sse
# MCP_URL=https://your-openshift-mcp-host/sse

# MCP_TRANSPORT=streamable-http
# MCP_URL=https://your-openshift-mcp-host/mcp

# Local stdio server. MCP_URL is not required.
# MCP_TRANSPORT=stdio
# MCP_COMMAND=npx
# MCP_ARGS=-y your-openshift-mcp-server

# Optional topic-check model. When either value is unset, that part uses
# ASSISTANT_MODEL at BASE_URL.
# GUARDRAIL_BASE_URL=https://your-smaller-vllm-host/v1
# GUARDRAIL_MODEL=your-lighter-model
